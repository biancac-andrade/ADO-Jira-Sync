{
  "name": "webhook-automation-azure",
  "version": "1.0.0",
  "description": "Webhook que recebe Azure DevOps Service Hooks e atualiza Jira (comentário + transição de status)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "typecheck": "tsc --noEmit",
    "tunnel": "ngrok http 3000",
    "tunnel:lt": "lt --port 3000",
    "test:jira": "node scripts/test-jira-connection.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2",
    "ngrok": "^5.0.0-beta.2",
    "localtunnel": "^2.0.2"
  }
}
