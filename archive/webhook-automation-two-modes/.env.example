PORT=3000
JIRA_BASE_URL=https://sua-org.atlassian.net
JIRA_USER_EMAIL=seu-email@empresa.com
# Token: sem aspas a menos que tenha # ou espaços. Sem espaço/newline no fim.
# Se der 401/404, gere um novo em: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=seu-token-jira
# Nome exato do status no Jira para "em revisão" (Fluxo 2)
JIRA_STATUS_CODE_REVIEW=In Code Review

# Opcional: quando a build roda na main (após merge da PR), o servidor usa este token para
# buscar a mensagem do commit na API do Azure DevOps e extrair a chave Jira (ex.: BEESEDI-2).
# Crie em: Azure DevOps → User settings → Personal access tokens (scope: Code Read).
AZURE_DEVOPS_PAT=

# Opcional: secret compartilhado para validar o webhook (header X-Webhook-Secret ou query ?secret=).
# Se definido, requisições sem o valor correto recebem 401.
WEBHOOK_SECRET=

# Opcional: persistência de eventos para métricas (pasta e arquivo JSONL). Desative com EVENT_STORE_DISABLED=1.
# EVENT_STORE_DIR=data
# EVENT_STORE_FILE=pipeline-events.jsonl
# EVENT_STORE_DISABLED=0

# Opcional: deduplicação de eventos (TTL em ms; padrão 1h).
# WEBHOOK_DEDUP_TTL_MS=3600000

# Opcional: retry Jira (tentativas e delay inicial em ms).
# JIRA_RETRY_ATTEMPTS=3
# JIRA_RETRY_DELAY_MS=1000

# Opcional (Azure Function): lista de repositórios permitidos (nomes separados por vírgula).
# Se definido, só eventos desses repos são processados; útil quando o Project tem vários times.
# ALLOWED_REPOS=repo-a,repo-b,repo-c,repo-d
